NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:4200
DB_PATH=../homeplants.sqlite
DB_AUTO_LOAD_ENTITIES=true
DB_SYNCHRONIZE=true
DB_LOGGING=false
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# OIDC Configuration (se vuote, abilita automaticamente il dev-user locale)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4200/api/auth/callback
OIDC_FRONTEND_REDIRECT_BASE_URL=http://localhost:4200

# Directory uploads
UPLOADS_DIR=../uploads

# SMTP Configuration per Notifiche Email (se vuote, le email vengono scritte su log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HomePlants" <noreply@homeplants.local>

